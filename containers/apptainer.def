Bootstrap: docker
From: python:3.11

%post
    apt-get update && apt-get install -y \
        curl \
        wget \
        tcsh \
        gcc \
        g++ \
        libgomp1 \
        libglib2.0-0

    # Install Python packages
    pip install numpy scipy nibabel matplotlib networkx scikit-image nilearn

    # Install AFNI (includes 3dClusterize)
    curl -O https://afni.nimh.nih.gov/pub/dist/bin/linux_ubuntu_16_64/@update.afni.binaries
    tcsh @update.afni.binaries -package linux_ubuntu_16_64 -do_extras

%environment
    export PATH=/usr/local/afni:$PATH

%runscript
    echo "Neuroimaging container ready (AFNI + Python)"
